{
  "manifest_version": 3,
  "name": "Js-Injection",
  "author": "AnOldStory",
  "version": "3.2.0",
  "description": "Javascript Injection Extension Tool for Chromium-based Web browsers",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": ["injection.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Js-Injection",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "options_page": "index.html",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"]
}
